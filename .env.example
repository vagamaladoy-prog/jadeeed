# ─── Copy to .env (local) and add the same variables in Vercel → Settings → Environment Variables ───

# Public address of the site (no trailing slash). Used in Telegram messages, SEO, the bot's Mini App button.
NEXT_PUBLIC_SITE_URL="https://jadeeed.vercel.app"

# ─── Supabase PostgreSQL (Project Settings → Database → Connection string) ───
# App: transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations: direct / session connection, port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ─── Supabase Storage (Project Settings → API). Service role key — server only, never public! ───
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Admin panel (/admin) ───
ADMIN_LOGIN="owner"
# Plain password OR (recommended) a bcrypt hash made with:  npm run admin:hash -- "your-password"
ADMIN_PASSWORD=""
# Random string ≥ 32 chars that signs the admin session cookie:  npm run secret
SESSION_SECRET=""

# ─── Telegram (@BotFather) ───
# Client bot: greeting + Mini App (its token also signs Mini App data)
TELEGRAM_BOT_TOKEN=""
# Admin bot: order notifications (optional — without it the client bot sends them)
TELEGRAM_ADMIN_BOT_TOKEN=""
# Order recipients are managed in the admin panel (Settings). Optional extra chat IDs, comma separated:
TELEGRAM_ADMIN_CHAT_ID=""
# Random string (A-Z a-z 0-9 _ -) that protects both bot webhooks:  npm run secret
TELEGRAM_WEBHOOK_SECRET=""
