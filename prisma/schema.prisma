// Jadeeed — database schema (Supabase PostgreSQL)
// Localised fields come in pairs: <field>Uz / <field>Ru.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Fit {
  OVERSIZE
  REGULAR
  SLIM
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum OrderSource {
  WEB
  TELEGRAM
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PromotionScope {
  PRODUCTS
  CATEGORY
}

enum HeaderTone {
  LIGHT // banner is light → dark logo/header text
  DARK // banner is dark → light logo/header text
}

/// Where a brand phrase is shown. One phrase may serve several slots.
enum PhraseSlot {
  HOME_QUESTION // big block under the banner ("Siz o'shami?")
  ADD_TO_CART // confirmation after "add to cart" ("Men o'sha.")
  ABOUT // brand block on home + about page ("Men o'sha.")
  WAITING // preloader, empty cart, 404, "continue shopping" ("Aylanib ketay...")
  THANKS // thank-you page ("Ko'z tegmasin.")
  BADGE // badge on new / bestseller products ("Ko'z tegmasin.")
  ATLAS_BLOCK // large phrase block on atlas on home
}

model Category {
  id            String     @id @default(cuid())
  slug          String     @unique
  nameUz        String
  nameRu        String
  descriptionUz String?
  descriptionRu String?
  image         String?
  sortOrder     Int        @default(0)
  isVisible     Boolean    @default(true)
  sizeChartId   String?
  sizeChart     SizeChart? @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  products      Product[]
  promotions    Promotion[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// rows: [{ size: "M", width: 54, length: 72, sleeve: 22 }] — centimetres
model SizeChart {
  id         String     @id @default(cuid())
  name       String
  rows       Json
  noteUz     String?
  noteRu     String?
  categories Category[]
  products   Product[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameUz        String
  nameRu        String
  descriptionUz String         @default("")
  descriptionRu String         @default("")
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sizeChartId   String?
  sizeChart     SizeChart?     @relation(fields: [sizeChartId], references: [id], onDelete: SetNull)
  fit           Fit            @default(REGULAR)
  price         Int // so'm
  oldPrice      Int? // manual "was" price; promotions override it
  compositionUz String         @default("")
  compositionRu String         @default("")
  density       Int? // g/m²
  careUz        String         @default("")
  careRu        String         @default("")
  isNew         Boolean        @default(false)
  isBestseller  Boolean        @default(false)
  isFeatured    Boolean        @default(false)
  isHidden      Boolean        @default(false)
  sortOrder     Int            @default(0)
  colors        ProductColor[]
  promotions    Promotion[]
  orderItems    OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isHidden, sortOrder])
  @@index([categoryId])
}

model ProductColor {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  nameUz    String
  nameRu    String
  hex       String // swatch colour (product colour, not UI palette)
  sortOrder Int            @default(0)
  images    ProductImage[]
  stock     Stock[]

  @@index([productId])
}

/// Ordered photos; position 0 = front, 1 = back.
model ProductImage {
  id       String       @id @default(cuid())
  colorId  String
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  url      String
  position Int          @default(0)
  width    Int?
  height   Int?

  @@index([colorId, position])
}

model Stock {
  id       String       @id @default(cuid())
  colorId  String
  color    ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size     Size
  quantity Int          @default(0)

  @@unique([colorId, size])
}

model Promotion {
  id         String         @id @default(cuid())
  name       String
  type       DiscountType   @default(PERCENT)
  value      Int // percent (1–90) or so'm
  scope      PromotionScope @default(PRODUCTS)
  categoryId String?
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  startsAt   DateTime?
  endsAt     DateTime?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Banner {
  id           String     @id @default(cuid())
  imageDesktop String // landscape, ≥ 2400×1350 — shown full-screen (cover)
  imageMobile  String? // portrait, ≥ 1080×1920 — shown full-screen on phones
  altUz        String // text that is inside the picture — goes to alt, never shown
  altRu        String
  link         String?
  headerTone   HeaderTone @default(DARK)
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model BrandPhrase {
  id        String       @id @default(cuid())
  text      String // never translated
  slots     PhraseSlot[]
  inMarquee Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Order {
  id               String      @id @default(cuid())
  number           Int         @unique @default(autoincrement())
  customerName     String
  phone            String
  comment          String?
  status           OrderStatus @default(NEW)
  total            Int
  source           OrderSource @default(WEB)
  telegramId       BigInt?
  telegramUsername String?
  locale           String      @default("uz")
  notifiedAt       DateTime? // Telegram notification delivered
  items            OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
}

/// Snapshot of what was bought — survives product edits/deletion.
model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  colorName   String
  colorId     String?
  size        Size
  quantity    Int
  price       Int // unit price paid
  image       String?

  @@index([orderId])
}

/// Singleton (id = 1): contacts, socials, static page texts.
model Settings {
  id                Int      @id @default(1)
  supportUsername   String   @default("jadeeedhizmat")
  supportUrl        String   @default("https://t.me/jadeeedhizmat")
  channelUsername   String   @default("jadeeeduz")
  channelUrl        String   @default("https://t.me/jadeeeduz")
  instagramUsername String   @default("jadeeed.uz")
  instagramUrl      String   @default("https://instagram.com/jadeeed.uz")
  phone             String?
  addressUz         String?
  addressRu         String?
  workHoursUz       String?
  workHoursRu       String?
  aboutUz           String   @default("")
  aboutRu           String   @default("")
  deliveryUz        String   @default("")
  deliveryRu        String   @default("")
  updatedAt         DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

/// Who receives order notifications from the admin bot. Added in the admin panel by @username or
/// numeric Telegram ID. A username gets its chatId when that person presses Start in the admin bot
/// (a bot can't write to someone who never started it).
model TelegramRecipient {
  id        String   @id @default(cuid())
  username  String?  @unique // lower-case, without @
  chatId    BigInt?  @unique
  name      String? // first name from Telegram, once known
  createdAt DateTime @default(now())
}
